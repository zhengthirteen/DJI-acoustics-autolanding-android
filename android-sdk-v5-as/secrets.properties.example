# Copy to secrets.properties (ignored by Git); do not overwrite existing local settings.
# This must match the Package Name registered for AIRCRAFT_API_KEY in DJI Developer Center.
APPLICATION_ID=com.zheng13.acousticslanding
# To reuse the original project's key, use APPLICATION_ID=com.zheng13.gradproject.
# Apps with the same APPLICATION_ID cannot coexist on the same Android user profile.
AIRCRAFT_API_KEY=
GMAP_API_KEY=
MAPLIBRE_TOKEN=

# Optional release signing. Paths are relative to android-sdk-v5-as/ or absolute.
# STORE_FILE=/absolute/path/to/acoustics-release.jks
# STORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
